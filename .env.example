# Default is DEMO. Set LIVE to seed a live scenario on first start.
CONTEXTOS_MODE=DEMO

# openai uses https://api.openai.com/v1 by default and requires an API key.
# openai-compatible or liquid use the supplied OpenAI-compatible base URL.
CONTEXTOS_FIRST_BRAIN_PROVIDER=
CONTEXTOS_FIRST_BRAIN_BASE_URL=
CONTEXTOS_FIRST_BRAIN_API_KEY=
CONTEXTOS_FIRST_BRAIN_MODEL=

# Set to liquid for a Liquid model exposed through an OpenAI-compatible endpoint.
# A hosted endpoint usually needs an API key; a local server may not.
CONTEXTOS_SECOND_BRAIN_PROVIDER=
CONTEXTOS_SECOND_BRAIN_BASE_URL=
CONTEXTOS_SECOND_BRAIN_API_KEY=
CONTEXTOS_SECOND_BRAIN_MODEL=

# Optional Nimble Extract v2 evidence source. The HTTPS page must contain one
# unambiguous line such as: api_version: v2 (no credentials/query in URL).
NIMBLE_ENABLED=false
NIMBLE_API_KEY=
NIMBLE_SOURCE_URL=

# Optional isolated storage path for local experiments.
# CONTEXTOS_DATA_DIR=
# Optional RawTree analytical mirror. Local state and event files remain authoritative.
RAWTREE_ENABLED=false
RAWTREE_API_KEY=
RAWTREE_BASE_URL=https://api.rawtree.com
RAWTREE_DATABASE=
RAWTREE_TABLE=contextos_events
